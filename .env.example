# Supabase: Project Settings -> Database -> Connection string (URI, "Direct connection").
# Any Postgres works too (Neon, RDS, local) as long as it accepts sslmode=require.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
JOB_SEARCH_URL=https://wellfound.com/role/l/software-engineer/india
JOB_SEARCH_PAGES=4

# Only needed to run the "auto" source (JOB_SOURCES=auto or JOB_SOURCES=...,auto).
# OPENROUTER_API_KEY is only actually called on a cache miss for AUTO_SOURCE_URL's
# hostname — see the "Auto-detected source" section in README.md.
AUTO_SOURCE_URL=
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id that supports response_format. Defaults to
# z-ai/glm-5.2:free. See https://openrouter.ai/models?max_price=0 for other free options.
OPENROUTER_MODEL=
