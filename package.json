{
  "name": "job-scrapper",
  "version": "1.0.0",
  "description": "Mini ETL pipeline for job listings: Playwright extraction, typed transformation, Postgres upsert",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/server.ts",
    "serve:dist": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
